# ==========================================
# ENTORNO Y APLICACIÓN
# ==========================================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_LOGGING_LEVEL=debug

# ==========================================
# BASE DE DATOS (Local PGLite / PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Duplicamos la variable para romper el aislamiento de Turbopack en desarrollo
NEXT_PUBLIC_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# ==========================================
# AUTENTICACIÓN (NextAuth / Auth.js)
# ==========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=desarrollo_secret_key_cambiar_en_produccion_123456789

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# OAuth - Facebook
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ==========================================
# PAGOS Y PASARELAS (Stripe & PayPal)
# ==========================================
# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox # sandbox | live

# ==========================================
# CACHÉ Y RATE LIMITING (Upstash / Redis)
# ==========================================
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ==========================================
# INTELIGENCIA ARTIFICIAL (OpenAI / Anthropic)
# ==========================================
OPENAI_API_KEY=sk-proj-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ==========================================
# INFRAESTRUCTURA Y NUBE (Aiven)
# ==========================================
AIVEN_API_TOKEN=aiven_api_token_here
AIVEN_PROJECT_NAME=my-aiven-project
AIVEN_SERVICE_NAME=pg-nextjs-template

# ==========================================
# EMAIL / NOTIFICACIONES (Resend / SMTP)
# ==========================================
RESEND_API_KEY="re_123456789"
CONTACT_RECIPIENT_EMAIL="tu-correo@gmail.com"
# Mientras no tengas un dominio propio verificado en Resend, usa el remite por defecto:
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (Uploadthing / S3)
# ==========================================
UPLOADTHING_TOKEN=your-uploadthing-token

# ==========================================
# ANALÍTICAS Y MONITOREO (PostHog / Sentry)
# ==========================================
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0