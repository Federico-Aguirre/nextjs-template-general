# Database (PGlite in development / PostgreSQL in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Public app URL used for metadata, sitemap, and robots.txt
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging: error | info | debug | warning | trace | fatal
NEXT_PUBLIC_LOGGING_LEVEL=info

# Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
